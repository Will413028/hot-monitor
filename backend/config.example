# Copy to backend/.env and fill locally. Never commit credentials.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
MONITOR_ENABLED=true
MONITOR_INTERVAL_SECONDS=300
MONITOR_AI_ENABLED=false
MONITOR_EXPANSION_ENABLED=false
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_FROM=
SMTP_TO=
SMTP_USERNAME=
SMTP_PASSWORD=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
